# Copy to .env (git-ignored). NEVER commit real values (Doc 4, Sec 1.1).

# --- Supabase (engine uses SERVICE ROLE key; dashboard uses ANON key only) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- MT5 (engine only; never exposed to dashboard) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_SYMBOL=UT100xx
# "native" = MetaTrader5 package in same Python (Windows Python under Wine)
# "bridge" = mt5linux RPyC bridge to Windows Python under Wine
MT5_MODE=bridge
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=18812

# --- Discord ---
DISCORD_WEBHOOK_URL=
# Separate channel for external-uptime / critical alerts (Doc 3, Sec 6)
DISCORD_CRITICAL_WEBHOOK_URL=

# --- Engine runtime ---
ALSE_ENV=demo
ALSE_BUFFER_DIR=./buffer
ALSE_HEALTH_PORT=8080
